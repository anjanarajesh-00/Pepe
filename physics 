import { TILE_SIZE, PHYSICS, GRID_COLS, GRID_ROWS } from '../../constants/layout';

export interface Rect {
  x: number;
  y: number;
  w: number;
  h: number;
}

export interface Body extends Rect {
  velX: number;
  velY: number;
  onGround: boolean;
}

// Convert tile coords to pixel position
export function tileToPixel(tx: number, ty: number) {
  return { x: tx * TILE_SIZE, y: ty * TILE_SIZE };
}

// Convert pixel position to tile coords
export function pixelToTile(px: number, py: number) {
  return {
    x: Math.floor(px / TILE_SIZE),
    y: Math.floor(py / TILE_SIZE),
  };
}

// Get tile value at grid position
export function getTile(grid: number[][], tx: number, ty: number): number {
  if (ty < 0 || ty >= grid.length) return 1; // treat out of bounds as solid
  if (tx < 0 || tx >= (grid[0]?.length ?? 0)) return 1;
  return grid[ty][tx];
}

// Check if a tile is solid (collidable)
export function isSolid(tile: number, playerId?: 'p1' | 'p2'): boolean {
  if (tile === 1) return true;
  if (tile === 4 && playerId === 'p2') return true; // p2 can't pass p1-only tiles
  if (tile === 5 && playerId === 'p1') return true; // p1 can't pass p2-only tiles
  return false;
}

export function isHazard(tile: number): boolean {
  return tile === 2 || tile === 3;
}

// Apply gravity to a body
export function applyGravity(body: Body, dt: number): Body {
  if (!body.onGround) {
    const newVelY = Math.min(
      body.velY + PHYSICS.GRAVITY,
      PHYSICS.MAX_FALL_SPEED
    );
    return { ...body, velY: newVelY };
  }
  return body;
}

// Resolve movement against grid collision
// Returns updated body + whether a hazard was hit
export function resolveCollision(
  body: Body,
  grid: number[][],
  playerId: 'p1' | 'p2'
): { body: Body; hitHazard: boolean } {
  let { x, y, velX, velY, w, h } = body;
  let onGround = false;
  let hitHazard = false;

  // Move X
  x += velX;
  const leftTile = Math.floor(x / TILE_SIZE);
  const rightTile = Math.floor((x + w - 1) / TILE_SIZE);
  const topTile = Math.floor(y / TILE_SIZE);
  const bottomTile = Math.floor((y + h - 1) / TILE_SIZE);

  for (let ty = topTile; ty <= bottomTile; ty++) {
    if (velX > 0 && isSolid(getTile(grid, rightTile, ty), playerId)) {
      x = rightTile * TILE_SIZE - w;
      velX = 0;
    }
    if (velX < 0 && isSolid(getTile(grid, leftTile, ty), playerId)) {
      x = (leftTile + 1) * TILE_SIZE;
      velX = 0;
    }
  }

  // Move Y
  y += velY;
  const newTopTile = Math.floor(y / TILE_SIZE);
  const newBottomTile = Math.floor((y + h - 1) / TILE_SIZE);
  const newLeftTile = Math.floor(x / TILE_SIZE);
  const newRightTile = Math.floor((x + w - 1) / TILE_SIZE);

  for (let tx = newLeftTile; tx <= newRightTile; tx++) {
    if (velY > 0 && isSolid(getTile(grid, tx, newBottomTile), playerId)) {
      y = newBottomTile * TILE_SIZE - h;
      velY = 0;
      onGround = true;
    }
    if (velY < 0 && isSolid(getTile(grid, tx, newTopTile), playerId)) {
      y = (newTopTile + 1) * TILE_SIZE;
      velY = 0;
    }
  }

  // Check hazards at current position
  const cx = Math.floor((x + w / 2) / TILE_SIZE);
  const cy = Math.floor((y + h / 2) / TILE_SIZE);
  if (isHazard(getTile(grid, cx, cy))) {
    hitHazard = true;
  }

  return {
    body: { x, y, w, h, velX, velY, onGround },
    hitHazard,
  };
}

// Check overlap between two rects
export function overlaps(a: Rect, b: Rect): boolean {
  return (
    a.x < b.x + b.w &&
    a.x + a.w > b.x &&
    a.y < b.y + b.h &&
    a.y + a.h > b.y
  );
}
